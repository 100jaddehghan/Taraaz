QWidget {font-family:"Segoe UI";font-size:14px;color:#182c37;background:#f3f5f4}
QLabel {background:transparent}
QLabel#brand {font-size:29px;font-weight:800;color:#126354}
QFrame#hero {background:#153c37;border-radius:18px}
QLabel#heading {font-size:32px;font-weight:700;color:white}
QLabel#light {color:#beded4}
QFrame#card {background:white;border:1px solid #d8e2dd;border-radius:12px;padding:8px}
QLabel#value {font-size:24px;font-weight:700;color:#143f38}
QLabel#muted {color:#526963}
QLabel#section {font-size:22px;font-weight:700}
QPushButton,QComboBox,QLineEdit,QDateEdit {padding:7px 12px;border:1px solid #bfd0c8;border-radius:7px;background:white}
QPushButton:hover {background:#e0eee8}
QPushButton#primary {background:#c4ee9d;color:#173727;font-weight:700;border-color:#b6dc95}
QTabWidget::pane {background:white;border:1px solid #d2ded7;border-radius:8px}
QTabBar::tab {padding:10px 20px;color:#516761;background:#e4ebe6}
QTabBar::tab:selected {background:#204e43;color:white}
QTableWidget {background:white;alternate-background-color:#f4f8f5;selection-background-color:#d6eadf;selection-color:#183f32;border:0}
QHeaderView::section {background:#e9f1eb;color:#354e43;border:0;padding:10px;font-weight:600}
QFrame#currencyStrip {background:#e1e9e5;border:1px solid #cfdbd4;border-radius:11px}
QPushButton#currency {min-width:36px;padding:6px 10px;border:0;border-radius:7px;background:transparent;color:#425c50;font-weight:600}
QPushButton#currency:hover {background:#d4e1d8}
QPushButton#currency:checked {background:#1f5144;color:white}
QPushButton#currency:focus {border:1px solid #779d86}
QFrame#card {padding:0;border-radius:14px}
QTableWidget::item {padding:0 10px;border-bottom:1px solid #edf1ed}
QHeaderView::section {padding:10px}
QTabBar::tab {margin-right:4px;border-top-left-radius:8px;border-top-right-radius:8px}
QPushButton#secondary {min-height:20px}
QMenu {padding:6px;border:1px solid #96ada2;border-radius:8px}
QMenu::item {padding:8px 14px}
QMenu::item:selected {background:#dcf0e4;color:#163e2e}
QDateEdit::drop-down {subcontrol-origin:padding;subcontrol-position:center right;width:28px;border:0;background:transparent}
QDateEdit::down-arrow {width:9px;height:9px}
QDateEdit::down-arrow {image:url("CHEVRON_PATH");width:12px;height:8px}
